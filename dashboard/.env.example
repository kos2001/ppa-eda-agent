# Public build-time endpoints; restart Vite/rebuild after changing them.
VITE_API_BASE_URL=http://127.0.0.1:8123
# Optional direct gateway fallback for a browser-pasted key.
VITE_GATEWAY_BASE_URL=http://127.0.0.1:8700
# A reverse proxy can instead use VITE_API_BASE_URL=/api (strip /api upstream).
# Never put API keys or other secrets in VITE_* variables.
