node_modules/
dashboard/dist/

# Real credentials (PPA_EDA_GATEWAY_KEY etc. — see server/index.mjs and
# .env.example). Never commit the real file, only .env.example.
.env

# Real EDA artifacts — large binary tool output and downloaded PDK, not
# source. Regenerate via pipeline/run_stage.py / pipeline/orchestrator.py
# and the volare command in docs/superpowers/specs/
# 2026-08-21-autonomous-layout-agent-design.md.
pdk/
pipeline/designs/*/runs/
__pycache__/

# AI review drafts, cached by server/index.mjs so reading one does not
# cost a fresh multi-minute model call every time the panel re-renders.
# Not evidence: a draft worth keeping is applied into the case, and one
# that was not applied says nothing about anything.
.cache/

# Playwright MCP scratch output (snapshots, console logs) from driving the
# dashboard in a browser during development. Never evidence, never source.
.playwright-mcp/

# Netlists generated from the schematics beside them (xschem writes
# <name>.spice from <name>.sch). Build artifacts of a checked-in source,
# regenerated by `custom_bridge.py netlist`. The hand-written baseline
# deck is kept — see its own header for why it is named that.
pipeline/analog/*/*.spice
!pipeline/analog/*/*_handwritten.spice
